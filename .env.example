# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor
PORT=3000

# Contraseña inicial del panel de administración (/admin).
# Se usa hasta que la cambies desde el panel (Ajustes > Seguridad).
ADMIN_PASSWORD=cambia-esta-clave

# Pon 1 para olvidar la contraseña guardada y volver a usar ADMIN_PASSWORD
# (útil si la olvidaste). Quítalo después de reiniciar.
# ADMIN_PASSWORD_RESET=1

# Carpeta donde se guardan la base de datos y las imágenes
# DATA_DIR=./data

# Si corres detrás de un proxy/balanceador (Nginx, Render, Railway, etc.)
# TRUST_PROXY=1
