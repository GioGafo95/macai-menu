{
  "name": "macai-infra",
  "version": "1.0.0",
  "private": true,
  "description": "Infraestructura de Macaí Bowls en AWS (CDK): CloudFront + S3 + Lambda + DynamoDB",
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth --all --quiet",
    "typecheck": "tsc --noEmit",
    "diff:qa": "cdk diff Macai-qa",
    "deploy:qa": "cdk deploy Macai-qa",
    "deploy:prod": "cdk deploy Macai-prod",
    "deploy:github": "cdk deploy Macai-github"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.276.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1148.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
